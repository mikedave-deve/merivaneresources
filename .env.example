# Copy this file to .env and fill in real values for local `vercel dev`.
# In production, set these as Environment Variables in the Vercel project settings.

# MongoDB Atlas — connection string from Atlas > Connect > Drivers.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=merivane

# Vercel Blob — generated automatically when you add the Blob store to your
# Vercel project (Storage tab). `vercel env pull` will fetch it for local dev.
BLOB_READ_WRITE_TOKEN=

# SMTP — used by Nodemailer to send the resume notification email.
# Works with any provider (Gmail app password, SendGrid, Mailgun, Postmark, Zoho, etc).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Address the "From" header shows (often must match/be verified with your SMTP provider).
MAIL_FROM=Merivane Resources <notifications@merivaneresources.com>

# Where new resume submissions get emailed.
RECRUITER_EMAIL=recruiting@merivaneresources.com

# Auth — random secret used to sign employee/admin session tokens (JWT).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=
